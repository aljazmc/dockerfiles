# written by ./project.sh scan
sbom/

# written by ./project.sh coverage
coverage/

# Images are tried out in their own directory, mounted as the container's
# home, which fills it with caches, renders and exports. So everything in an
# image directory is ignored, except the files that build and describe the
# image.
/*/alpine/*
/*/debian/*
/*/buildfor*/*
/image-spinner/*

!/*/*/Dockerfile
!/*/*/README.md
!/*/*/docker-entrypoint.sh
!/*/*/*.sources
!/*/*/bundle
!/*/*/makedmg
!/*/*/makeexe
!/*/*/makesh

!/image-spinner/Dockerfile
!/image-spinner/README.md
!/image-spinner/docker-entrypoint.sh
